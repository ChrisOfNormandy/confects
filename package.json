{
    "author": "chrisofnormandy",
    "description": "A collection of React / JSX components.",
    "keywords": [],
    "license": "MIT",
    "name": "@dead-harbour/react-elements",
    "packageManager": "yarn@4.17.0",
    "type": "module",
    "version": "1.0.2",
    "files": [
        "dist"
    ],
    "exports": {
        "./style.css": "./dist/react-elements.css",
        "./buttons": {
            "types": "./dist/lib/buttons.d.ts",
            "import": "./dist/buttons.js",
            "require": null
        },
        "./containers": {
            "types": "./dist/lib/containers.d.ts",
            "import": "./dist/containers.js",
            "require": null
        },
        "./decorations": {
            "types": "./dist/lib/decorations.d.ts",
            "import": "./dist/decorations.js",
            "require": null
        },
        "./helpers": {
            "types": "./dist/lib/helpers.d.ts",
            "import": "./dist/helpers.js",
            "require": null
        },
        "./inputs": {
            "types": "./dist/lib/inputs.d.ts",
            "import": "./dist/inputs.js",
            "require": null
        },
        "./providers": {
            "types": "./dist/lib/providers.d.ts",
            "import": "./dist/providers.js",
            "require": null
        },
        "./selectors": {
            "types": "./dist/lib/selectors.d.ts",
            "import": "./dist/selectors.js",
            "require": null
        },
        "./types": {
            "types": "./dist/lib/types.d.ts",
            "import": "./dist/types.js",
            "require": null
        }
    },
    "dependencies": {
        "@dead-harbour/shipshape": "^1.0.2",
        "bootstrap-icons": "^1.13.1",
        "react-tooltip": "^6.0.8",
        "sass": "^1.101.0"
    },
    "devDependencies": {
        "@dead-harbour/scss-rigging": "^1.0.3",
        "@stylistic/stylelint-config": "^5.0.0",
        "@stylistic/stylelint-plugin": "^5.2.0",
        "@types/node": "^26.0.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "eslint": "^10.5.0",
        "knip": "^6.20.0",
        "postcss": "^8.5.15",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "stylelint": "^17.14.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-scss": "^7.2.0",
        "tsc-alias": "^1.8.17",
        "typescript": "^6.0.3",
        "vite": "^8.1.0"
    },
    "peerDependencies": {
        "@dead-harbour/scss-rigging": ">=1",
        "@dead-harbour/shipshape": ">=1",
        "@types/react": ">=19",
        "react": ">=19",
        "react-dom": ">=19"
    },
    "scripts": {
        "build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "build": "yarn clean; yarn build:types && vite build",
        "bump:pre": "npm version --commit-hooks false --git-tag-version false prerelease",
        "bump": "npm version --commit-hooks false --git-tag-version false patch",
        "clean": "rm -r ./dist",
        "dev": "DEV=1 vite",
        "lint": "eslint . --fix && yarn stylelint '**/*.scss' --fix",
        "prerelease": "yarn lint && yarn knip && yarn build && yarn bump:pre && git add --a",
        "release": "yarn lint && yarn knip && yarn build && yarn bump && git add --a",
        "sanity": "yarn typecheck && yarn lint && yarn knip",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    }
}
