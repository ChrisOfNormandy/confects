{
    "author": "chrisofnormandy",
    "description": "A collection of React / JSX components.",
    "keywords": [],
    "license": "MIT",
    "name": "@syren-dev-tech/confects",
    "packageManager": "yarn@4.13.0",
    "type": "module",
    "version": "0.2.1-0",
    "files": [
        "dist"
    ],
    "exports": {
        "./style.css": "./dist/confects.css",
        "./buttons": {
            "types": "./dist/lib/buttons.d.ts",
            "import": "./dist/buttons.js",
            "require": null
        },
        "./containers": {
            "types": "./dist/lib/containers.d.ts",
            "import": "./dist/containers.js",
            "require": null
        },
        "./decorations": {
            "types": "./dist/lib/decorations.d.ts",
            "import": "./dist/decorations.js",
            "require": null
        },
        "./helpers": {
            "types": "./dist/lib/helpers.d.ts",
            "import": "./dist/helpers.js",
            "require": null
        },
        "./inputs": {
            "types": "./dist/lib/inputs.d.ts",
            "import": "./dist/inputs.js",
            "require": null
        },
        "./providers": {
            "types": "./dist/lib/providers.d.ts",
            "import": "./dist/providers.js",
            "require": null
        },
        "./selectors": {
            "types": "./dist/lib/selectors.d.ts",
            "import": "./dist/selectors.js",
            "require": null
        },
        "./types": {
            "types": "./dist/lib/types.d.ts",
            "import": "./dist/types.js",
            "require": null
        }
    },
    "dependencies": {
        "@syren-dev-tech/concauses": "^0.1.3",
        "@syren-dev-tech/confetti": "^0.2.1-0",
        "bootstrap-icons": "^1.13.1",
        "react-tooltip": "^5.30.0",
        "sass": "^1.98.0"
    },
    "devDependencies": {
        "@stylistic/stylelint-config": "^5.0.0",
        "@stylistic/stylelint-plugin": "^5.1.0",
        "@types/node": "^25.5.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "eslint": "^9.27.0",
        "knip": "^6.2.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "stylelint": "^17.6.0",
        "typescript": "^6.0.2",
        "vite": "^8.0.3"
    },
    "peerDependencies": {
        "@syren-dev-tech/confetti": ">=0.2.0",
        "@types/react": ">=19",
        "react": ">=19",
        "react-dom": ">=19"
    },
    "scripts": {
        "build": "yarn clean; tsc -p tsconfig.build.json && vite build",
        "bump:pre": "npm version --commit-hooks false --git-tag-version false prerelease",
        "bump": "npm version --commit-hooks false --git-tag-version false patch",
        "clean": "rm -r ./dist",
        "dev": "DEV=1 vite",
        "lint": "eslint . --fix && yarn stylelint '**/*.scss'",
        "prerelease": "yarn lint && yarn knip && yarn build && yarn bump:pre && git add --a",
        "release": "yarn lint && yarn knip && yarn build && yarn bump && git add --a",
        "sanity": "yarn typecheck && yarn lint && yarn knip",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    }
}
